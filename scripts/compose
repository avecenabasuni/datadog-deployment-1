#!/usr/bin/env bash
# Prefer the Docker Compose plugin, with standalone Compose as a fallback.
set -euo pipefail

if docker compose version >/dev/null 2>&1; then
  exec docker compose "$@"
elif docker-compose version >/dev/null 2>&1; then
  exec docker-compose "$@"
else
  printf '%s\n' '[ERROR] Docker Compose is unavailable.' '[NEXT ] Install the Docker Compose plugin or docker-compose, then retry.' >&2
  exit 127
fi
